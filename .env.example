# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Data encryption key — required to store patient conversations on disk
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=your_fernet_key_here

# Gmail sender
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Emergency — on-call coordinator
ONCALL_EMAIL=oncall@clinic.com

# Department coordinators
CARDIOLOGY_EMAIL=cardiology@clinic.com
DERMATOLOGY_EMAIL=dermatology@clinic.com
GENERAL_EMAIL=general@clinic.com
